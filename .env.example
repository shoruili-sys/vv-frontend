# URL interna do Strapi no docker network
STRAPI_URL=http://strapi:1337
# URL pública (para uso em SSR/links)
NEXT_PUBLIC_STRAPI_URL=https://strapi.vivaverissimo.com.br
# URL pública do site (usado em redirecionamentos e CORS)
NEXT_PUBLIC_SITE_URL=https://vivaverissimo.com.br
# Token de leitura (READ) do Strapi - gerar em Settings > API Tokens
STRAPI_API_TOKEN=seu_token_aqui
# Webhook opcional para CRM (RD Station, HubSpot, etc.)
CRM_WEBHOOK_URL=
# Telefone/WhatsApp exibido no site
NEXT_PUBLIC_WHATSAPP=5511999999999
